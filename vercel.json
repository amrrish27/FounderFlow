{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/:path*", "destination": "/frontend/:path*" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{dataset/**,reports/**,notebooks/**,**/__pycache__/**,frontend/index-old.html,frontend/script-old.js,frontend/style-old.css}"
    }
  }
}
