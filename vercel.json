{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/api/health", "dest": "/api/health.py" },
    { "src": "/api/predict", "methods": ["POST"], "dest": "/api/predict.py" },
    { "src": "/api/feature-importance", "dest": "/api/feature-importance.py" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{dataset/**,reports/**,notebooks/**,**/__pycache__/**,frontend/index-old.html,frontend/script-old.js,frontend/style-old.css}"
    }
  }
}
